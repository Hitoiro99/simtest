5
(
    left
    {
        type            cyclic;
        inGroups        List<word> 1(cyclic);
        nFaces          32;
        startFace       220;
        matchTolerance  0.0001;
        neighbourPatch  right;
        transformType   translational;
        separation      (-0.1 0 0);
    }
    right
    {
        type            cyclic;
        inGroups        List<word> 1(cyclic);
        nFaces          32;
        startFace       252;
        matchTolerance  0.0001;
        neighbourPatch  left;
        transformType   translational;
        separation      (0.1 0 0);
    }
    lowerWall
    {
        type            wall;
        inGroups        List<word> 1(wall);
        nFaces          4;
        startFace       284;
    }
    upperWall
    {
        type            wall;
        inGroups        List<word> 1(wall);
        nFaces          4;
        startFace       288;
    }
    frontAndBack
    {
        type            empty;
        inGroups        List<word> 1(empty);
        nFaces          256;
        startFace       292;
    }
